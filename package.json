{
  "name": "wowf-gold-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WoW Forever market radar: collects auction snapshots, finds gold making plays, alerts on Discord.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "engine": "tsx src/engine/main.ts",
    "start": "npm run build:web && tsx src/engine/main.ts",
    "once": "tsx src/engine/main.ts --once",
    "contract": "tsx scripts/contract.ts",
    "replay": "tsx scripts/replay.ts",
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "match-house": "tsx scripts/match-house.ts",
    "publish-times": "tsx scripts/publish-times.ts",
    "ladder": "tsx scripts/ladder.ts",
    "compare-houses": "tsx scripts/compare-houses.ts",
    "plays": "tsx scripts/plays.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@tanstack/react-query": "^5.108.0",
    "fastify": "^5.12.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}
