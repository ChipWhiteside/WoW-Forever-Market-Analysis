{
  "name": "wowf-gold-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WoW Forever market radar: collects auction snapshots, finds gold making plays, alerts on Discord.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "engine": "tsx src/engine/main.ts",
    "start": "npm run build:web && tsx src/engine/main.ts",
    "once": "tsx src/engine/main.ts --once",
    "contract": "tsx scripts/contract.ts",
    "replay": "tsx scripts/replay.ts",
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
